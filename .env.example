# --- WhatsApp Cloud API (from Meta developer console) ---
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Any string you make up yourself - you'll re-enter this exact value in the
# Meta webhook setup screen. Treat it like a password.
WHATSAPP_VERIFY_TOKEN=choose_a_random_string

# --- Who is allowed to use the bot ---
# Comma-separated "Name:PhoneNumber" pairs. Phone numbers must be in the
# same format WhatsApp sends them in webhooks: country code + number, no
# "+", no spaces, no dashes. Example for two people in Colombia:
# ALLOWED_NUMBERS=Pau:573001112233,Ale:573004445566
ALLOWED_NUMBERS=Pau:573000000000,Partner:573000000001

# --- Behavior ---
# Comma-separated list of "minutes before due" reminders to send for timed
# tasks. Default is 2 hours before AND 15 minutes before.
REMINDER_OFFSETS_MINUTES=120,15
# 24h time (HH:MM) for the once-a-day nudge about tasks with no set time.
DAILY_REMINDER_TIME=09:00
# When adding a timed task, warn if another open task is due within this
# many minutes of it (a possible double-booking).
CONFLICT_WINDOW_MINUTES=60
# IANA timezone used for parsing times like "at 3pm" and for scheduling.
TIMEZONE=America/Bogota

# --- Voice notes and smarter understanding (optional) ---
# Free account at console.groq.com. Without this, the bot still works fine
# for text - it just can't transcribe voice notes, and any message that
# isn't a recognized command (help/list/"listo <n>"/"compra: ...") gets
# added as a literal task instead of being understood (e.g. follow-ups like
# "divide eso en dos tareas").
GROQ_API_KEY=your_groq_api_key
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional - defaults to openai/gpt-oss-20b if not set. Groq's model lineup
# changes over time; if this one ever stops working, list what's available
# with GET https://api.groq.com/openai/v1/models (Authorization: Bearer
# <your GROQ_API_KEY>) and set this to one of the returned ids.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# --- Server ---
PORT=3000
# Where the SQLite database file lives. On Railway, point this at a path
# inside a mounted volume (e.g. /data/app.db) so data survives redeploys.
DB_PATH=./data/app.db
